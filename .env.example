# Copy to .env and set these to `id -u` / `id -g` on each development host.
LOCAL_UID=1000
LOCAL_GID=1000

# Explicit mounts; large assets remain outside this repository.
VQA_CHECKPOINT_DIR=/absolute/path/to/checkpoint/best
VIDEO_DIR=/absolute/path/to/video/directory
# Optional: use the unchanged VLMotion package directly instead of the pinned external checkout.
# VQA_SOURCE_DIR=/home/lester/VLMotion/ros2_ws/src/lightweight_risk_vqa
# Copy the camera template here and set measured serial numbers.
# REALSENSE_CONFIG=./config/local/cameras.yaml
# VIDEO_GID=44
# RS_VIDEO0=/dev/video0
# RS_VIDEO1=/dev/video1
# RS_VIDEO2=/dev/video2
# RS_VIDEO3=/dev/video3
# RS_VIDEO4=/dev/video4
# RS_VIDEO5=/dev/video5
# Optional reuse of an existing validated GPU image; default is the buildable worker image.
# VQA_WORKER_IMAGE=itri-retail-robot:vqa-worker
# VQA_BACKEND=http
# HAND_BACKEND=mediapipe
# CAMERA_SOURCE=video
# VIDEO_PATH=/data/video/example.mp4
