# Copy to .env and set these to `id -u` / `id -g` on each development host.
LOCAL_UID=1000
LOCAL_GID=1000

# Native GUI uses DISPLAY and XAUTHORITY from your Ubuntu desktop terminal.
# make gui-setup prepares a private, ignored authorization file; do not commit it.

# Project-local assets (weights/video remain ignored by Git).
VQA_CHECKPOINT_DIR=./models/vqa/best
VQA_SOURCE_DIR=./vendor/lightweight_risk_vqa
VIDEO_DIR=./data/video
YOLO_MODEL_FILE=./models/yolo/yolov8n.pt
# sentence_safe is structure-checked in isolated fake hardware; baseline is original decoding.
VQA_DECODING_PROFILE=sentence_safe
# Original engine is the default. Current local fake profile explicitly tests grammar_cached.
VQA_GENERATION_ENGINE=hf
# Copy the camera template here and set measured serial numbers.
# REALSENSE_CONFIG=./config/local/cameras.yaml
# VIDEO_GID=44
# RS_VIDEO0=/dev/video0
# RS_VIDEO1=/dev/video1
# RS_VIDEO2=/dev/video2
# RS_VIDEO3=/dev/video3
# RS_VIDEO4=/dev/video4
# RS_VIDEO5=/dev/video5
# Optional reuse of an existing validated GPU image; default is the buildable worker image.
# VQA_WORKER_IMAGE=itri-retail-robot:vqa-worker
# VQA_BACKEND=http
# HAND_BACKEND=mediapipe
# CAMERA_SOURCE=video
# VIDEO_PATH=/data/video/example.mp4

# Original yolo-assisted mode; supply existing weights (no automatic download).
# YOLO_MODEL_FILE=./models/yolo/yolov8n.pt
