Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 30; 35; 43
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Floor
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 24
  - Class: rviz_default_plugins/Map
    Name: Shop Map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
    Alpha: 0.5
  - Class: rviz_default_plugins/RobotModel
    Name: TidyBot and OpenArm
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/Marker
    Name: Decisions and Task Status
    Enabled: true
    Topic:
      Value: /retail/status_markers
  - Class: rviz_default_plugins/Path
    Name: Navigation Plan
    Enabled: true
    Topic:
      Value: /plan
    Line Style: Lines
    Line Width: 0.05
    Color: 30; 230; 100
  - Class: rviz_default_plugins/PointCloud2
    Name: Shelf Cloud
    Enabled: true
    Topic:
      Value: /perception/shelf/cloud
      Durability Policy: Transient Local
    Size (m): 0.025
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 100; 190; 255
  - Class: rviz_default_plugins/Image
    Name: Chest RGB and VQA Decision
    Enabled: true
    Topic:
      Value: /perception/vqa/chest/annotated
      Reliability Policy: Best Effort
    Normalize Range: true
  - Class: rviz_default_plugins/Image
    Name: Hand Detection
    Enabled: false
    Topic:
      Value: /perception/hand/annotated
      Reliability Policy: Best Effort
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.5
      Pitch: 0.55
      Yaw: 0.8
      Focal Point:
        X: 1.1
        Y: 0.0
        Z: 0.9
      Target Frame: map
Window Geometry:
  Width: 1600
  Height: 1000
