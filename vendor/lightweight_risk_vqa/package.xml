<?xml version="1.0"?>
<package format="3">
  <name>lightweight_risk_vqa</name>
  <version>0.3.0</version>
  <description>ConvLSTM/Qwen VQA and external VLM baseline, with optional YOLO/ROS adapters.</description>
  <maintainer email="hrclab.nthu@gmail.com">hrc</maintainer>
  <license>MIT</license>
  <exec_depend>future_risk_vqa</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
