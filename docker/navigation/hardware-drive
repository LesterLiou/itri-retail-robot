#!/bin/bash
set -euo pipefail
if [[ "${ROS_DOMAIN_ID:-}" != 0 || "$#" != 1 || ( "$1" != true && "$1" != false ) ]]; then
  echo 'Hardware drive requires local domain 0 and an explicit map setting' >&2
  exit 1
fi
python3 /opt/itri/navigation/check_hardware_graph.py
exec ros2 run retail_core tidybot_drive --ros-args \
  -p hardware:=true -p "allow_map_goals:=$1" \
  -r /base/cmd_vel:=/cmd_vel -r /base/enable:=/tidybot/enable \
  -r /base/control_frame:=/tidybot/control_frame
